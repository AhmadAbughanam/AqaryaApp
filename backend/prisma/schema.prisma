generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  citizen
  admin
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum PropertyStatus {
  pending_verification
  needs_changes
  verified
  rejected
  frozen
  sold
}

enum BlockchainRecordStatus {
  pending
  anchored
  failed
}

enum MarketType {
  sale
  investment
  rent
}

enum AuditActionType {
  login
  listing_submitted
  listing_verified
  listing_rejected
  listing_frozen
  listing_changes_requested
  anchor
  simulate
  opportunity_submitted
  opportunity_approved
  opportunity_rejected
  opportunity_published
  opportunity_unpublished
  opportunity_simulate
  thread_created
  message_sent
  provider_under_review
  provider_verified
  provider_rejected
  provider_suspended
  provider_notes_updated
  report_created
  report_reviewed
}

enum ReportStatus {
  open
  under_review
  resolved
  dismissed
}

enum ReportTargetType {
  listing
  opportunity
}

enum ReportReason {
  spam
  fraud
  misleading_info
  inappropriate
  duplicate
  other
}

enum FlagSeverity {
  low
  medium
  high
}

enum AnnouncementAudience {
  all_citizens
  all_providers
  one_user
}

enum AnnouncementStatus {
  active
  archived
}

enum SavedItemType {
  listing
  opportunity
}

enum SearchType {
  sale
  rent
  investment
}

enum NotificationType {
  listing_status_change
  investment_milestone
  new_message
  saved_search_match
  system
  provider_status_change
  report_update
}

enum InvestmentOpportunityStatus {
  draft
  submitted
  under_review
  approved
  published
  rejected
}

enum TrustBadgeTier {
  verified
  premium_verified
  aqarya_approved
}

enum AccountType {
  individual
  owner
  agency
  developer
  partner
}

enum ProviderVerificationStatus {
  unverified
  under_review
  verified
  rejected
  suspended
}

model User {
  id                    String                  @id @default(cuid())
  username              String                  @unique
  passwordHash          String
  role                  UserRole
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  ownedProperties       Property[]
  simulations           Simulation[]
  investmentSimulations InvestmentSimulation[]
  auditLogs             AuditLog[]
  savedItems            SavedItem[]
  threads               Thread[]               @relation("CitizenThreads")
  sentMessages          Message[]              @relation("SentMessages")
  preference            UserPreference?
  savedSearches         SavedSearch[]
  notifications         Notification[]
  providerProfile       ProviderProfile?
  reports               ModerationReport[]
  wallet                Wallet?
}

enum WalletTxType {
  deposit
  withdrawal
  purchase
  rent_payment
  investment
  dividend
  refund
}

enum WalletTxStatus {
  pending
  completed
  failed
}

model Wallet {
  id              String             @id @default(cuid())
  userId          String             @unique
  ejodBalance     Float              @default(0)
  lockedAmount    Float              @default(0)
  pendingDeposits Float              @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id            String         @id @default(cuid())
  walletId      String
  type          WalletTxType
  amount        Float
  status        WalletTxStatus @default(pending)
  description   String
  propertyTitle String?
  reference     String?        @unique
  createdAt     DateTime       @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
}

model Property {
  id                         String                @id @default(cuid())
  ownerId                    String?
  marketType                 MarketType            @default(sale)
  title                      String
  location                   String
  ownerName                  String
  ownershipType              String
  ownershipProofType         String
  ownershipProofNumber       String
  description                String
  imageUrls                  Json?
  price                      Float
  propertyValue              Float
  totalShares                Int
  availableShares            Int
  status                     PropertyStatus        @default(pending_verification)
  propertyVerificationStatus VerificationStatus    @default(pending)
  identityVerificationStatus VerificationStatus    @default(pending)
  rejectionReason            String?
  reviewerNotes              String?
  verificationTimestamp      DateTime?
  verificationRecordId       String?
  verificationPayload        Json?
  city                       String?
  propertyType               String?
  bedrooms                   Int?
  bathrooms                  Int?
  areaSqm                    Float?
  amenities                  Json?
  latitude                   Float?
  longitude                  Float?
  blockchainHash             String?
  blockchainTxId             String?
  blockchainStatus           BlockchainRecordStatus @default(pending)
  anchoredAt                 DateTime?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  owner                      User?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  simulations                Simulation[]
  auditLogs                  AuditLog[]
  savedItems                 SavedItem[]
  threads                    Thread[]              @relation("ListingThreads")

  @@index([ownerId])
  @@index([status])
  @@index([marketType])
  @@index([city])
  @@index([latitude, longitude])
}

model Simulation {
  id                  String   @id @default(cuid())
  userId              String
  propertyId          String
  shares              Int
  pricePerShare       Float
  subtotal            Float
  platformFee         Float
  governmentFee       Float
  totalAmount         Float
  ownershipPercentage Float
  expectedAnnualReturn Float
  expectedFiveYearReturn Float
  simulatedValue      Float
  createdAt           DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
}

model AuditLog {
  id         String          @id @default(cuid())
  actorId    String?
  actorRole  UserRole
  actionType AuditActionType
  propertyId String?
  metadata   Json
  timestamp  DateTime        @default(now())

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([propertyId])
  @@index([timestamp])
}

model InvestmentOpportunity {
  id                  String                      @id @default(cuid())
  status              InvestmentOpportunityStatus @default(draft)
  title               String
  location            String
  description         String
  imageUrls           Json?
  assetClass          String
  stage               String
  sponsorName         String
  ownershipStructure  String
  distributionModel   String
  exitModel           String
  totalShares         Int
  availableShares     Int
  pricePerShare       Float
  minimumShares       Int
  targetIrr           Float
  targetCashYield     Float
  targetHoldYears     Int
  appreciationRate    Float
  occupancyRate       Float
  managementFeeRate   Float
  riskBand            String
  trustScore          Int?
  trustBadge          TrustBadgeTier?
  reviewNotes         String?
  rejectionReason     String?
  publishedAt         DateTime?
  reviewedAt          DateTime?
  reviewedBy          String?
  verificationRecordId String?
  blockchainHash      String?
  blockchainTxId      String?
  blockchainStatus    BlockchainRecordStatus      @default(pending)
  anchoredAt          DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  investmentSimulations InvestmentSimulation[]
  savedItems            SavedItem[]
  threads               Thread[]              @relation("OpportunityThreads")

  @@index([status])
  @@index([assetClass])
  @@index([riskBand])
}

model InvestmentSimulation {
  id                     String   @id @default(cuid())
  userId                 String
  opportunityId          String
  shares                 Int
  pricePerShare          Float
  subtotal               Float
  platformFee            Float
  governmentFee          Float
  totalAmount            Float
  ownershipPercentage    Float
  expectedAnnualReturn   Float
  expectedFiveYearReturn Float
  simulatedValue         Float
  holdingPeriodYears     Int
  exitScenario           String
  reinvestDistributions  Boolean
  annualGrossIncome      Float
  annualManagementFee    Float
  annualNetCashFlow      Float
  exitFee                Float
  projectedExitValue     Float
  projectedNetExitProceeds Float
  projectedProfit        Float
  equityMultiple         Float
  createdAt              DateTime @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity InvestmentOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([opportunityId])
}

model SavedItem {
  id            String        @id @default(cuid())
  userId        String
  type          SavedItemType
  propertyId    String?
  opportunityId String?
  savedAt       DateTime      @default(now())

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property?              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  opportunity InvestmentOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([propertyId])
  @@index([opportunityId])
}

model Thread {
  id            String    @id @default(cuid())
  subject       String
  citizenId     String
  listingId     String?
  opportunityId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  citizen     User                   @relation("CitizenThreads", fields: [citizenId], references: [id], onDelete: Cascade)
  listing     Property?              @relation("ListingThreads", fields: [listingId], references: [id], onDelete: SetNull)
  opportunity InvestmentOpportunity? @relation("OpportunityThreads", fields: [opportunityId], references: [id], onDelete: SetNull)
  messages    Message[]

  @@index([citizenId])
  @@index([listingId])
  @@index([opportunityId])
}

model Message {
  id         String   @id @default(cuid())
  threadId   String
  senderId   String
  senderRole UserRole
  body       String
  createdAt  DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
}

model UserPreference {
  userId               String  @id
  notificationsEnabled Boolean @default(true)
  language             String  @default("en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedSearch {
  id         String     @id @default(cuid())
  userId     String
  name       String
  searchType SearchType
  filters    Json
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ProviderProfile {
  id                         String                     @id @default(cuid())
  userId                     String                     @unique
  accountType                AccountType
  providerVerificationStatus ProviderVerificationStatus @default(unverified)
  businessName               String?
  contactPerson              String?
  phone                      String?
  email                      String?
  registrationNumber         String?
  licenseNumber              String?
  providerType               String?
  documentUrls               Json?
  adminNotes                 String?
  rejectionReason            String?
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  reviewedBy                 String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountType])
  @@index([providerVerificationStatus])
}

model ModerationReport {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  reporterId String
  reason     ReportReason
  notes      String?
  status     ReportStatus     @default(open)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

model QualityFlag {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  rule       String
  severity   FlagSeverity
  details    String
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([targetType, targetId])
  @@index([rule])
  @@index([severity])
}

model Announcement {
  id           String               @id @default(cuid())
  title        String
  body         String
  type         NotificationType
  audience     AnnouncementAudience
  targetUserId String?
  status       AnnouncementStatus   @default(active)
  createdBy    String
  createdAt    DateTime             @default(now())
  sentAt       DateTime?
  archivedAt   DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([audience])
}

model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  body      String
  icon      String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([active])
  @@index([order])
}
