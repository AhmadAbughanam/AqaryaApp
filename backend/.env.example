# Copy this file to .env and fill in the values for your environment.
# Never commit .env — it is listed in .gitignore.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aqarya_dev?schema=public"

# JWT signing secret — use a long random string in production (required)
JWT_SECRET="replace-with-a-strong-random-secret"

# JWT token lifetime (optional, default: 1d)
JWT_EXPIRES_IN="1d"

# HTTP port the NestJS server listens on (optional, default: 3000)
PORT=3000

# Comma-separated browser origins allowed to call the API directly.
# Leave empty when the frontend uses the included same-origin Nginx proxy.
CORS_ORIGINS="http://localhost:5173"

# Reverse proxies trusted for protocol/client IP forwarding.
TRUST_PROXY="2"

# Blockchain/verification provider (optional — defaults to mock mode when unset)
# BLOCKCHAIN_PROVIDER="mock-chain"
# BLOCKCHAIN_NETWORK="local-simnet"
# BLOCKCHAIN_RECORD_PREFIX="aqarya-vrf"
