# Caddy config for the Aqarya static SPA.
#
# Copy the site block below into your server's Caddyfile (usually
# /etc/caddy/Caddyfile), replacing any existing `reverse_proxy` block for this
# domain, then reload Caddy:
#
#   caddy reload --config /etc/caddy/Caddyfile
#   # or: systemctl reload caddy
#
# The build output (dist/) must be deployed to the `root` path below.
# See DEPLOY.md.

aqarya.online {
	root * /var/www/aqarya
	encode zstd gzip

	# Client-side routes (/app, /admin, /login, …) must fall back to index.html.
	try_files {path} /index.html
	file_server

	# Long-cache the fingerprinted assets, never cache the HTML shell.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}

# If you also want the bare apex or www to redirect here:
# www.aqarya.online {
# 	redir https://aqarya.online{uri} permanent
# }
