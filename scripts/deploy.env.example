# Copy this file to scripts/deploy.env and fill in your VPS details.
# scripts/deploy.env is git-ignored so your server details stay out of the repo.

# SSH user on the VPS
DEPLOY_USER=root

# VPS hostname or IP
DEPLOY_HOST=your-vps.example.com

# Directory Caddy serves from (must match `root` in the Caddyfile)
DEPLOY_PATH=/var/www/aqarya

# Optional: SSH port (default 22)
DEPLOY_PORT=22
