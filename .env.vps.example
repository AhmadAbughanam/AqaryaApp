# Copy to .env on the VPS. Never commit the real .env file.
POSTGRES_DB=aqarya
POSTGRES_USER=aqarya
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
JWT_EXPIRES_IN=1d
# Private host port used by the existing host-level reverse proxy.
HTTP_PORT=8081

# Only needed when another browser origin calls the API directly.
CORS_ORIGINS=
# Host reverse proxy -> container Nginx -> NestJS (two trusted hops).
TRUST_PROXY=2

# The included verification service defaults to a mock provider until an
# official blockchain integration is configured.
BLOCKCHAIN_PROVIDER=mock-chain
BLOCKCHAIN_NETWORK=production
BLOCKCHAIN_RECORD_PREFIX=aqarya-vrf
